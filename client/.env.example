# Supabase (public — safe in client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used in email links; no trailing slash)
NEXT_PUBLIC_APP_URL=

# Email — delivered by the `mailer` Cloud Run service (see /mailer).
# Base URL of the deployed service, no trailing slash.
MAILER_URL=
# Must match MAILER_SHARED_SECRET on the Cloud Run service.
MAILER_SHARED_SECRET=

# Signing secret for one-click email actions (server-only)
EMAIL_ACTION_SECRET=

# --- Private mailer access via Workload Identity Federation ---------------
# Set once the workload identity pool exists. Full audience string, i.e.
# //iam.googleapis.com/projects/<num>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# Leave blank if the mailer is publicly invocable (shared secret only).
GCP_WORKLOAD_IDENTITY_AUDIENCE=
# Optional. Only needed if Cloud Run rejects the federated access token and an
# OIDC ID token is required instead.
MAILER_INVOKER_SERVICE_ACCOUNT=
# Local development only: `gcloud auth print-identity-token`, valid ~1 hour.
# Lets `npm run dev` reach the private mailer without Vercel's OIDC token.
MAILER_ID_TOKEN=

# --- Participant ID photos (Google Cloud Storage) --------------------------
# Bucket holding the driver-licence images, same "<userId>/<ms>-id.<ext>" paths
# as the old Supabase id-documents bucket.
GCS_ID_DOCUMENTS_BUCKET=texasjurystudy-id-documents
# Service account the app acts as for listing, deleting and URL signing. On
# Vercel it is reached keylessly through GCP_WORKLOAD_IDENTITY_AUDIENCE above
# (the org forbids service-account keys). Locally the module impersonates it
# from your gcloud ADC (`gcloud auth application-default login`), which needs
# roles/iam.serviceAccountTokenCreator on this account.
GCS_ID_DOCUMENTS_SERVICE_ACCOUNT=id-documents-app@sound-observer-505819-t5.iam.gserviceaccount.com
