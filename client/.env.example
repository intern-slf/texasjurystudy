# Supabase (public — safe in client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used in email links; no trailing slash)
NEXT_PUBLIC_APP_URL=

# Email — delivered by the `mailer` Cloud Run service (see /mailer).
# Base URL of the deployed service, no trailing slash.
MAILER_URL=
# Must match MAILER_SHARED_SECRET on the Cloud Run service.
MAILER_SHARED_SECRET=

# Signing secret for one-click email actions (server-only)
EMAIL_ACTION_SECRET=

# --- Private mailer access via Workload Identity Federation ---------------
# Set once the workload identity pool exists. Full audience string, i.e.
# //iam.googleapis.com/projects/<num>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
# Leave blank if the mailer is publicly invocable (shared secret only).
GCP_WORKLOAD_IDENTITY_AUDIENCE=
# Optional. Only needed if Cloud Run rejects the federated access token and an
# OIDC ID token is required instead.
MAILER_INVOKER_SERVICE_ACCOUNT=
# Local development only: `gcloud auth print-identity-token`, valid ~1 hour.
# Lets `npm run dev` reach the private mailer without Vercel's OIDC token.
MAILER_ID_TOKEN=

# --- Participant ID photos (Google Cloud Storage) --------------------------
# Bucket holding the driver-licence images, same "<userId>/<ms>-id.<ext>" paths
# as the old Supabase id-documents bucket.
GCS_ID_DOCUMENTS_BUCKET=texasjurystudy-id-documents
# Service account the app acts as for listing, deleting and URL signing. On
# Vercel it is reached keylessly through GCP_WORKLOAD_IDENTITY_AUDIENCE above
# (the org forbids service-account keys). Locally the module impersonates it
# from your gcloud ADC (`gcloud auth application-default login`), which needs
# roles/iam.serviceAccountTokenCreator on this account.
GCS_ID_DOCUMENTS_SERVICE_ACCOUNT=id-documents-app@sound-observer-505819-t5.iam.gserviceaccount.com

# --- Online invoice payment (Stripe) ----------------------------------------
# Leave STRIPE_SECRET_KEY empty and online payment stays off: no Pay button,
# firms pay by check as before. Use a RESTRICTED key (rk_...), not the secret
# key (sk_...), with write access to Checkout Sessions and read access to
# PaymentIntents (for the card brand and last 4 on the invoice). Production
# refuses a test key. A
# sandbox key locally and on previews; the live key only in Vercel Production.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_...). Locally, from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`; deployed, from
# Stripe Dashboard → Developers → Webhooks → the endpoint for
# https://<app>/api/stripe/webhook, subscribed to checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
# and checkout.session.expired.
STRIPE_WEBHOOK_SECRET=
# Previews only: extra addresses (comma-separated, exact hostnames) Stripe may
# send a payer back to, besides the deployment's own VERCEL_URL and
# VERCEL_BRANCH_URL, e.g. an alias you test on. Production ignores it.
PREVIEW_RETURN_HOSTS=

# --- Error alerts (Sentry) ---------------------------------------------------
# Leave empty and nothing is sent (local dev, CI). In Vercel, set it for
# Production (and Preview if you want preview errors too, tagged "preview").
# From sentry.io → the project → Settings → Client Keys (DSN). Public by
# design: it only lets the browser send errors in.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: the build uploads source maps when all
# three are set. Token from sentry.io → Settings → Auth Tokens (org token).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
